# 默认：文本文件统一用 LF（跨平台脚本必须）
* text=auto eol=lf

# Shell / Python / 服务脚本必须是 LF，否则 Linux 上无法执行
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
control     text eol=lf
preinst     text eol=lf
postinst    text eol=lf
prerm       text eol=lf
postrm      text eol=lf

# 二进制
*.deb       binary
*.gz        binary
*.bz2       binary
*.png       binary

# 保留 CRLF 的（Windows 专用）
*.bat       text eol=crlf
*.ps1       text eol=crlf